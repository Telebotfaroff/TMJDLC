# Telegram (configure later)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_OWNER_ID=
TELEGRAM_VIDEO_CHANNEL_ID=

# Neon PostgreSQL (configure later)
DATABASE_URL=

# Provider settings will be added after HTML inspection.

# Bounded download/upload pipeline (Google Colab)
# Runtime upload concurrency is selected in the Telegram Settings menu (1 or 2; default 1).
TMJDLC_MAX_PARALLEL=2
TMJDLC_MAX_PENDING_UPLOADS=1
TMJDLC_UPLOAD_QUEUE_POLL_SECONDS=2
TMJDLC_MIN_FREE_DISK_GB=3
TMJDLC_AUTO_CLEAN=true

# WZGram / Telegram MTProto upload engine
TMJDLC_TELEGRAM_LOG_LEVEL=INFO
# WZML-X-style helper bot tokens, comma or space separated (optional).
# Each helper bot must be an administrator in the video destination channel.
TG_HELPER_BOT_TOKENS=
# WZGram concurrent transmission slots per client.
TMJDLC_UPLOAD_WORKERS=100
TMJDLC_UPLOAD_FLOOD_RETRIES=5

# Split oversized videos into parts below Telegram's per-file upload limit (1.8 GB default)
TMJDLC_TELEGRAM_MAX_FILE_BYTES=1800000000


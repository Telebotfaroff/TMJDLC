# Telegram Bot API (control and progress messages only)
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# Runtime
TMJDLC_WORK_DIR=/content/TMJDLC-temp
TMJDLC_MAX_PARALLEL_DOWNLOADS=2
TMJDLC_MAX_PARALLEL_UPLOADS=1
TMJDLC_LOG_LEVEL=INFO

# Google Drive library
TMJDLC_DRIVE_ROOT_NAME=TMJDLC Library
# Optional: set this to reuse a specific existing Drive folder.
TMJDLC_DRIVE_ROOT_ID=
